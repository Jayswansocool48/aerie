[Desktop Entry]
Type=Application
Name=Aerie
GenericName=Live Wallpapers
Comment=Live wallpapers for COSMIC: 2D, 3D, video, shaders, web and Wallpaper Engine
Exec=aerie
Icon=io.github.jayswansocool48.Aerie
Terminal=false
Categories=Utility;Settings;DesktopSettings;
Keywords=wallpaper;live wallpaper;wallpaper engine;lively;shader;shadertoy;parallax;blender;3D;anime;lock screen;widgets;desktop;Deskscape;
StartupNotify=false
Actions=Studio;Create;Quit;

[Desktop Action Studio]
Name=Aerie Studio
Exec=aerie --studio

[Desktop Action Create]
Name=Make a Wallpaper
Exec=aerie --studio --page=create

[Desktop Action Quit]
Name=Quit
Exec=aerie --quit
