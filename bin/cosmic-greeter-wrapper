#!/bin/sh
# Installed by Aerie when you turn on "Use Aerie as my lock screen" (Aerie Studio → Lock screen).
#
# COSMIC starts "cosmic-greeter" in every session to be its lock screen (and for the login
# screen). While Aerie's switch is on, that name points here: for people who turned the Aerie
# lock screen on, Aerie's lock screen runs; for everyone else, and for the login screen,
# COSMIC's own one runs exactly as before. Turning the switch off (or uninstalling Aerie)
# puts COSMIC's file back.
#
# Safety: if Aerie's lock screen fails 3 times within 2 minutes, COSMIC's own lock screen is
# used until you log in again, so you can never be left without one.

REAL=/usr/bin/cosmic-greeter.real

AERIE_LOCK=/usr/lib/aerie/bin/aerie-lock
FLAG="${XDG_CONFIG_HOME:-$HOME/.config}/aerie/lock.enabled"

if [ "$(id -un)" != "cosmic-greeter" ] && [ -x "$AERIE_LOCK" ] && [ -f "$FLAG" ]; then
    STATE="${XDG_RUNTIME_DIR:-/tmp/aerie-$(id -u)}/aerie-lock"
    mkdir -p "$STATE" 2>/dev/null
    if [ ! -f "$STATE/use-cosmic" ]; then
        "$AERIE_LOCK" --daemon
        code=$?
        [ "$code" -eq 0 ] && exit 0
        now=$(date +%s)
        echo "$now $code" >> "$STATE/failures"
        recent=0
        while read -r when _; do
            [ $((now - when)) -lt 120 ] && recent=$((recent + 1))
        done < "$STATE/failures"
        if [ "$recent" -lt 3 ]; then
            exit "$code"   # COSMIC starts us again, and Aerie locks again if it was locked
        fi
        touch "$STATE/use-cosmic"
        if [ -f "$STATE/locked" ]; then
            # the screen is still locked: let COSMIC's lock screen take over and ask for the password
            (sleep 2; loginctl lock-session) >/dev/null 2>&1 &
        fi
    fi
fi

if [ ! -x "$REAL" ]; then
    echo "aerie: COSMIC's lock screen ($REAL) is missing; reinstall cosmic-greeter" >&2
    exit 1
fi
exec "$REAL" "$@"
